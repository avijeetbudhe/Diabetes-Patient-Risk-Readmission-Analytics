            <column caption='Readmission Window' datatype='string' name='[Parameter 2445124788506624]' param-domain-type='list' role='measure' type='nominal' value='&quot;30-Day&quot;'>
              <calculation class='tableau' formula='&quot;30-Day&quot;' />
            </column>
            <column caption='Include Expired/Hospice' datatype='string' name='[Parameter 2445124789452801]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
            <column caption='Encounter Scope' datatype='string' name='[Parameter 2445124789719042]' param-domain-type='list' role='measure' type='nominal' value='&quot;All Encounters&quot;'>
              <calculation class='tableau' formula='&quot;All Encounters&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vlc5p009xdqd31c1rrel13e3ekf'>
            <column caption='Readmission Flag (Dynamic)' datatype='integer' name='[Calculation_2445124790517765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2445124788506624] = &quot;30-Day&quot; THEN [readmit_30_flag]&#10;ELSE [readmit_any_flag]&#10;END' />
            </column>
            <column caption='Readmission Rate' datatype='real' default-format='p0.0%' name='[Calculation_2445124790632454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2445124790517765]) / COUNT([encounter_id])' />
            </column>
            <column caption='Scope Filter' datatype='boolean' name='[Calculation_2445124790849543]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 2445124789452801] = &quot;Include&quot; OR [expired_or_hospice_flag] = 0)&#10;AND&#10;([Parameters].[Parameter 2445124789719042] = &quot;All Encounters&quot; OR [first_encounter_flag] = 1)' />
            </column>
            <column caption='Encounter Id' datatype='integer' name='[encounter_id]' role='measure' type='quantitative' />
            <column caption='Expired Or Hospice Flag' datatype='integer' name='[expired_or_hospice_flag]' role='measure' type='quantitative' />
            <column caption='First Encounter Flag' datatype='integer' name='[first_encounter_flag]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2445124790849543]' derivation='None' name='[none:Calculation_2445124790849543:nk]' pivot='key' type='nominal' />
            <column caption='Readmit 30 Flag' datatype='integer' name='[readmit_30_flag]' role='measure' type='quantitative' />
            <column caption='Readmit Any Flag' datatype='integer' name='[readmit_any_flag]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2445124790632454]' derivation='User' name='[usr:Calculation_2445124790632454:qk]' pivot='key' type='quantitative' />
