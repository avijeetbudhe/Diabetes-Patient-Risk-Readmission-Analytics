              <calculation class='tableau' formula='IF [Parameters].[Parameter 2445124788506624] = &quot;30-Day&quot; THEN [readmit_30_flag]&#10;ELSE [readmit_any_flag]&#10;END' />
            </column>
            <column caption='Scope Filter' datatype='boolean' name='[Calculation_2445124790849543]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 2445124789452801] = &quot;Include&quot; OR [expired_or_hospice_flag] = 0)&#10;AND&#10;([Parameters].[Parameter 2445124789719042] = &quot;All Encounters&quot; OR [first_encounter_flag] = 1)' />
            </column>
            <column caption='Risk Score' datatype='integer' name='[Calculation_2445124790972424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [number_inpatient] &gt;= 2 THEN 3&#10;ELSEIF [number_inpatient] = 1 THEN 1&#10;ELSE 0&#10;END&#10;+ IIF([number_emergency] &gt;= 1, 2, 0)&#10;+ IIF([number_outpatient] &gt;= 1, 1, 0)&#10;+ IIF([number_diagnoses] &gt;= 8, 1, 0)&#10;+ IIF([time_in_hospital] &gt;= 7, 1, 0)' />
            </column>
            <column caption='Risk Segment' datatype='string' name='[Calculation_2445124791078921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2445124790972424] &gt;= 4 THEN &quot;High Risk&quot;&#10;ELSEIF [Calculation_2445124790972424] &gt;= 2 THEN &quot;Medium Risk&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
            </column>
            <column caption='Estimated Readmission Cost' datatype='integer' name='[Calculation_2445124791214090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2445124790517765]) * 13000' />
            </column>
            <column caption='Cost Per Patient' datatype='real' name='[Calculation_2445125502783515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2445124791214090] / COUNT([encounter_id])' />
            </column>
            <column caption='Encounter Id' datatype='integer' name='[encounter_id]' role='measure' type='quantitative' />
            <column caption='Expired Or Hospice Flag' datatype='integer' name='[expired_or_hospice_flag]' role='measure' type='quantitative' />
            <column caption='First Encounter Flag' datatype='integer' name='[first_encounter_flag]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2445124790849543]' derivation='None' name='[none:Calculation_2445124790849543:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2445124791078921]' derivation='None' name='[none:Calculation_2445124791078921:nk]' pivot='key' type='nominal' />
            <column caption='Number Diagnoses' datatype='integer' name='[number_diagnoses]' role='measure' type='quantitative' />
            <column caption='Number Emergency' datatype='integer' name='[number_emergency]' role='measure' type='quantitative' />
            <column caption='Number Inpatient' datatype='integer' name='[number_inpatient]' role='measure' type='quantitative' />
            <column caption='Number Outpatient' datatype='integer' name='[number_outpatient]' role='measure' type='quantitative' />
